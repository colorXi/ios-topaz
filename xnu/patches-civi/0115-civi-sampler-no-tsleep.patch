--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -19,6 +19,28 @@
 #include <kern/task.h>
 #include <kern/thread.h>
 #include <pexpert/pexpert.h>
+#include <kern/clock.h>
+
+extern void thread_yield_to_preemption(void);
+
+/*
+ * civi: tsleep never wakes on this port (see sweet_ufs.c), so wait in 10 ms
+ * slices and yield between them.
+ */
+static void
+sweet_sample_wait(int seconds)
+{
+	uint64_t ticks = 0;
+
+	nanoseconds_to_absolutetime(10000000ull, &ticks);
+	for (int i = 0; i < seconds * 100; i++) {
+		uint64_t t0 = mach_absolute_time();
+		while ((mach_absolute_time() - t0) < ticks) {
+			__asm__ __volatile__("isb" ::: "memory");
+		}
+		thread_yield_to_preemption();
+	}
+}
 
 extern task_t proc_task(proc_t);
