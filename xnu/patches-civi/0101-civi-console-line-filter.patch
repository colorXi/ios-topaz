+/*
+ * civi: launchd logs one "exec xpcproxy" line per spawn, and they arrive in
+ * bursts that scroll the 75-row panel clean within seconds -- exactly when a
+ * crash message matters. Buffer the head of each line and drop whole lines
+ * whose prefix is noise, so what stays on the panel is what we need to read.
+ */
+static const char *const fbcon_mute_prefixes[] = {
+	"exec ",
+	"ifnet_attach",
+	"skip attaching",
+	"dlil_init",
+	"[System Event]",
+};
+
 static void
-fbcon_transmit_data(uint8_t c)
+fbcon_emit(uint8_t c)
 {
-	if (c == '\r') {
