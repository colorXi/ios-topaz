@@ -221,6 +224,23 @@
 	 * swap (backboardd presents at 60 Hz) saturated the CPU and the phone
 	 * looked dead; show the latest dirty frame every fFlushTicks ticks.
 	 */
+	if (fb->fPowerOff) {
+		/* Fade out: halve every channel each vsync, then black, then idle. */
+		uint32_t step = fb->fFadeStep;
+		if (step <= 6) {
+			fb->fFadeStep = step + 1;
+		}
+		if (step <= 6) {
+			for (uint32_t y = 0; y < fb->fHeight; y++) {
+				volatile uint32_t *row = (volatile uint32_t *)(fb->fPixels + (uint64_t)y * fb->fRowBytes);
+				for (uint32_t x = 0; x < fb->fWidth; x++) {
+					row[x] = step < 6 ? (row[x] >> 1) & 0x7f7f7f7f : 0;
+				}
+			}
+		}
+		sender->setTimeoutUS(SWEET_FB_VSYNC_US);
+		return;
+	}
 	if (fb->fDirty && (count % fb->fFlushTicks) == 0) {
 		uint8_t *rec = (uint8_t *)IOMalloc(SWEET_FB_SWAP_REC_SIZE);
 		if (rec != NULL) {
@@ -502,6 +522,19 @@
