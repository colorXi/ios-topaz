--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -495,5 +495,8 @@
 #if DEBUG_BSDINIT
-#define bsd_init_kprintf(x, ...) kprintf("bsd_init: " x, ## __VA_ARGS__)
+#define bsd_init_kprintf(x, ...) printf("bsd_init: " x, ## __VA_ARGS__)
 #else
-#define bsd_init_kprintf(x, ...)
+/* civi: use printf, not kprintf. On this port kprintf output reaches the
+ * msgbuf but not the framebuffer console, and the panel is the only channel
+ * we have; every other line that shows up on screen comes from printf. */
+#define bsd_init_kprintf(x, ...) printf("bsd_init: " x, ## __VA_ARGS__)
 #endif
